{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cortex/src/cli.ts",
              "hook",
              "claude.sessionstart",
              "--plugin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cortex/src/cli.ts",
              "hook",
              "claude.stop",
              "--plugin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cortex/src/cli.ts",
              "hook",
              "claude.stopfailure",
              "--plugin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cortex/src/cli.ts",
              "hook",
              "claude.precompact",
              "--plugin"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cortex/src/cli.ts",
              "hook",
              "claude.sessionend",
              "--plugin"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
