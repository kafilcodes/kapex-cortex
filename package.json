{
  "name": "kapex-cortex",
  "version": "4.5.2",
  "description": "Claude Code plugin: lossless handoffs between chats (a mission contract that survives /clear and new chats), a live status strip and cost/cache panel, and Dreams that check CLAUDE.md and memory against what really happened. Zero dependencies.",
  "license": "MIT",
  "author": {
    "name": "Mohd. Kafil Khan",
    "url": "https://github.com/kafilcodes"
  },
  "homepage": "https://github.com/kafilcodes/kapex-cortex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kafilcodes/kapex-cortex.git"
  },
  "bugs": {
    "url": "https://github.com/kafilcodes/kapex-cortex/issues"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "claude-desktop",
    "context-management",
    "session-handoff",
    "ai-agent-memory",
    "claude-md",
    "prompt-cache",
    "mcp",
    "token-cost",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "cortex": "bin/cortex"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node scripts/bundle-plugin.ts --check && npm test",
    "bundle": "node scripts/bundle-plugin.ts",
    "build:sea": "node scripts/build-sea.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.9"
  }
}
